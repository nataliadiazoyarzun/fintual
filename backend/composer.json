{
    "name": "fintual/portfolio-rebalancer",
    "description": "Portfolio rebalancing domain logic",
    "type": "project",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
